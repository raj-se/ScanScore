# --- Google Gemini (resume scoring, free tier) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Encryption for locked (paywalled) analysis content ---
# Any random string, 32+ characters. Generate with: openssl rand -hex 32
ANALYSIS_SECRET=

# --- Full-report unlock price (dummy checkout — no real payment provider) ---
# Shown in the UI button/modal only. No payment is actually processed.
NEXT_PUBLIC_FULL_REPORT_PRICE_DISPLAY=₹49

# --- Adzuna (live job listings) ---
# Free account at https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Country code Adzuna should search: in, us, gb, ca, au, etc.
ADZUNA_COUNTRY=in
